[Unit]
Description=Abrehamrahi API Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=abrehamrahi
Group=abrehamrahi
WorkingDirectory=/opt/abrehamrahi
EnvironmentFile=/etc/abrehamrahi.env
ExecStart=/opt/abrehamrahi/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8765 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/abrehamrahi
UMask=0077

[Install]
WantedBy=multi-user.target

